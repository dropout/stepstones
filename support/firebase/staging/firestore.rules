rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins carry a custom auth claim granted by set_admin_claim.mjs.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Only the authenticated owner can access their profile document.
    match /profiles/{profileId} {
      allow read, write: if request.auth != null
        && request.auth.uid == profileId;
    }

    // Allow the profile owner to access documents in profile subcollections,
    // while keeping statsAudit governed by its more restrictive rule below.
    match /profiles/{profileId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == profileId
        && subcollection != 'statsAudit';
    }

    // Stats audit trail: owner can write, nobody can read or delete from clients.
    match /profiles/{profileId}/statsAudit/{entryId} {
      allow create, update: if request.auth != null
        && request.auth.uid == profileId;
      allow read, delete: if false;
    }

    // Authenticated users can read chants; only admins can write them.
    // playCount is server-maintained, so admin writes must leave it untouched.
    match /chants/{chantId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.id == chantId
        && !('playCount' in request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.id == chantId
        && request.resource.data.get('playCount', null)
          == resource.data.get('playCount', null);
      allow delete: if isAdmin();
    }

    // Only authenticated users can access presence.
    match /presence/{presenceId} {
      allow read, write: if request.auth != null;
    }

    // Server-maintained aggregates: readable by admins, never client-writable.
    match /global_stats/{document=**} {
      allow read: if isAdmin();
    }

  }
}

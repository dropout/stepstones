rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Chant assets are downloaded by every signed-in user, uploaded only by admins.
    match /chants/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /profiles/{authId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == authId;
    }

  }
}
